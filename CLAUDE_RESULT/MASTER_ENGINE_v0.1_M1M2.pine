//@version=6
// =============================================================================
// XAUUSD MASTER ENGINE — v0.1 (MILESTONE 1+2 SKELETON)
// =============================================================================
// STATUS: IN-PROGRESS SKELETON. NOT A COMPLETE TRADING ENGINE.
// This file contains ONLY:
//   MILESTONE 1 — Pine v6 namespacing & source compatibility layer
//   MILESTONE 2 — Canonical Master Engine data types
//
// Detection logic (Liquidity/Sweep adapters, CRT, CISD, MSS, Context,
// Displacement, POI, SMT, Regime, Execution, Signal Engine, Genealogy,
// Debug, Alerts, Backtest) is INTENTIONALLY NOT YET WIRED. It arrives in
// Milestones 3-16 per the locked Implementation Order. Wiring it in early
// would violate the "no uncontrolled giant pass" development rule.
//
// SOURCE ATTRIBUTION (preserved per spec §39 / Architecture Spec §B.2):
//   crt_*   <- "CRT Pro+ by Artas"                (CRT Pro+.pine)
//   cisd_*  <- "CISD PRO+"                         (CISD pro+.pine)
//   ifvg_*  <- "IFVG " (IFVG Pro+)                 (IFVG_pro_.pine)
//   uni_*   <- "Unicorn Model pro"                 (unicornmodel.pine)
//              Mozilla Public License 2.0 — Copyright (c) 2026 fxraptor-alpha
//   ts_*    <- "ICT Turtle Soup Model"             (ICT_Turtle_Soup_Model.pine)
//   me_*    <- Master Engine synthesis (no source; see XAUUSD_MASTER_ENGINE.md)
//   liq_*   <- Master Engine canonical wrapper (synthesis)
//
// NAMESPACING RULE (Architecture Spec §B, Correction #1 from approval):
//   Renaming types/functions to avoid Pine v6 collisions is a MECHANICAL
//   change only. No algorithmic/semantic behavior has been altered in this
//   milestone. Internal field names, function bodies, and thresholds are
//   preserved verbatim from source wherever they appear below.
// =============================================================================

indicator(
     "XAUUSD Master Engine [DEV — M1+M2 Skeleton]",
     shorttitle    = "XAU-ME-DEV",
     overlay       = true,
     max_bars_back = 5000,     // Architecture Spec §F.3 — single script-wide value
     max_lines_count   = 500,  // Architecture Spec §F.1 — shared ceiling, all modules
     max_boxes_count   = 500,
     max_labels_count  = 500,
     max_polylines_count = 100)

// =============================================================================
// PART 0 — MASTER ENGINE GLOBAL CONSTANTS (Master synthesis)
// =============================================================================
// Fixed HTF hierarchy per spec: 1W -> 1D -> 4H -> 1H -> 30M (primary execution).
// These are NOT the source files' own auto-timeframe systems (CRT autoHTF,
// Unicorn getAutoHTFs, CISD getHTFPeriod, IFVG autoHTF, Turtle Soup
// f_fractalTF) — those are superseded per Correction #2 (request.security
// optimization pass) and are NOT ported into this build. This removal is a
// deliberate Master Engine architectural decision, documented here.

me_TF_1W  = "1W"
me_TF_1D  = "1D"
me_TF_4H  = "240"
me_TF_1H  = "60"
me_TF_30M = "30"

me_SMT_PAIR = "XAGUSD"   // fixed per spec — CRT's dynamic getSMTPair() ticker-matching
                          // apparatus is NOT ported (Source Audit, Technical Risk #8).
                          // This is a documented Master Engine modification: CRT's
                          // generic-market SMT pairing is replaced with the fixed
                          // XAUUSD<->XAGUSD pair mandated by the spec.

// =============================================================================
// PART 1 — MASTER ENGINE CANONICAL DATA TYPES  (Architecture Spec §B.1)
// =============================================================================
// Pure Master Engine synthesis. No source equivalent. These are the shared
// interchange objects that every namespaced source engine will populate via
// adapter functions in later milestones (Milestone 3 onward).

type me_LiquidityObject
    string source            // "CRT_HTF" | "UNICORN_A" | "UNICORN_B" | "UNICORN_C" | "UNICORN_D" | "IFVG_HTF" | "TURTLESOUP_PIVOT"
    string liqType           // "BSL" | "SSL" | "INTERNAL" | "EXTERNAL" | "MAJOR" | "MINOR"
    string tf                // resolved timeframe string
    float  price
    int    createdBar
    string status            // "CREATED" | "ACTIVE" | "SWEPT" | "CONSUMED" | "INVALIDATED" | "EXPIRED"
    int    sweptBar
    bool   isMasterPrimary   // true only for CRT-oriented 4H liquidity (Locked Decision #1)

type me_SweepEvent
    string source            // "CRT" (Master primary) | "UNICORN" | "IFVG" | "TURTLESOUP" (diagnostic only)
    string direction         // "BULLISH_SWEEP" | "BEARISH_SWEEP" | "NO_SWEEP"
    string tf
    int    barIndex
    float  sweepExtreme
    float  sweptLevel
    bool   isMasterPrimary

type me_StructureEvent
    string kind               // "CISD_BULL" | "CISD_BEAR" | "MSS_BULL" | "MSS_BEAR" | "NONE"
    string sourceEngine       // "cisd_Engine" | "ts_MSS"
    int    barIndex
    float  level
    bool   normalizedToStructureConfirmed

type me_DisplacementEvent
    string state              // "NONE" | "WEAK" | "VALID" | "STRONG"
    float  measuredValue
    float  thresholdUsed
    int    barIndex

type me_SMTSubSignal
    string kind                // "HTF_DIVERGENCE" | "PIVOT_DIVERGENCE"
    string state               // "BULLISH" | "BEARISH" | "NONE"
    int    barIndex
    string pair                // fixed: "XAGUSD"

type me_SMTAggregate
    string state                // "BULLISH_SMT" | "BEARISH_SMT" | "NEUTRAL" | "CONTRADICTORY"
    me_SMTSubSignal htfSignal
    me_SMTSubSignal pivotSignal

type me_ContextState
    string tf                  // "1W" | "1D"
    string state                // "BULLISH" | "BEARISH" | "NEUTRAL" | "TRANSITION"
    string basis                 // human-readable structural justification (HH/HL, LH/LL etc.)

type me_SetupGenealogy          // spec §29 — mandatory traceability record (populated Milestone 13)
    string id
    string direction             // "LONG" | "SHORT"
    me_ContextState ctx1W
    me_ContextState ctx1D
    me_LiquidityObject liq4H
    me_SweepEvent sweep4H
    string crtModelUsed           // "MODEL_1_OB" | "MODEL_2_RECLAIM" | "BOTH"
    string reclaimState           // "WAIT_RECLAIM" | "RECLAIM_CONFIRMED" | "RECLAIM_FAILED"
    me_StructureEvent structure1H
    me_DisplacementEvent displacement
    string poiType                 // "FVG" | "IFVG" | "UNICORN"
    string poiRef
    me_SMTAggregate smt
    bool   regimePermits
    string execution30M             // "PENDING" | "CONFIRMED"
    string finalState               // "WAIT" | "LONG_CANDIDATE" | "SHORT_CANDIDATE" | "LONG_ENTRY" | "SHORT_ENTRY" | "INVALIDATED" | "EXPIRED"
    float  entry
    float  sl
    float  tp

// =============================================================================
// PART 2 — NAMESPACED SOURCE TYPES (Architecture Spec §B.2)
// =============================================================================
// Field lists are copied verbatim from source. Only the TYPE NAME is renamed
// to its namespaced form to avoid Pine v6 identifier collisions on merge.
// -----------------------------------------------------------------------------

// ---- crt_* (source: CRT Pro+ by Artas) -------------------------------------
type crt_Candle
    float           o
    float           c
    float           h
    float           l
    int             o_idx
    box             body
    line            wick_up
    line            wick_down
    label           sweepLbl

type crt_CandleSettings
    bool            show
    string          htf
    int             max_display

type crt_Settings
    color           bull_body
    color           bull_border
    color           bull_wick
    color           bear_body
    color           bear_border
    color           bear_wick
    int             offset
    int             buffer
    int             width

type crt_CandleSet
    crt_Candle[]    candles
    crt_CandleSettings settings
    label           tfLabel
    line[]          sweepLines

type crt_SMT
    string smtType
    string smtPair
    float prevChartHigh
    float currChartHigh
    int prevChartHighTime
    int currChartHighTime
    float prevChartLow
    float currChartLow
    int prevChartLowTime
    int currChartLowTime
    bool confirmed
    int creationBar
    line smtLine
    label smtLabel

type crt_Model
    box             rangeBox
    line            separatorLine
    line            sweepLine
    label           sweepLabel
    line            targetLine
    label           targetLabel
    line            cisdLine
    label           cisdLabel
    label           c1Label
    label           c2Label
    label           c3Label
    string          bias         = "Neutral"
    string          status       = "Formation"
    float           h            = na
    float           l            = na
    float           o            = na
    float           c            = na
    int             startBar     = na
    int             endBar       = na
    int             h_bar        = na
    int             l_bar        = na
    float           h_bar_open   = na
    float           l_bar_open   = na
    float           manipOpen    = na   // CRT's internal "CISD" level — routes to
                                         // crt_Reclaim / Master CRT Engine ONLY.
                                         // This is NOT the Master CISD Engine
                                         // (Locked Decision #3 / Architecture §C.3).
    int             manipBar     = na
    bool            sweptHigh    = false
    bool            sweptLow     = false
    bool            dpurge       = false
    bool            cisdDone     = false  // field name preserved verbatim from
                                            // source; semantically this is CRT's
                                            // own reclaim-confirmation flag, not
                                            // the Master CISD Engine's output.
    int             cisdBar      = na
    float           cisdLevel    = na

// ---- cisd_* (source: CISD PRO+) — AUTHORITATIVE MASTER CISD ENGINE SOURCE --
type cisd_FVG
    box fvgBox
    line midline
    label fvgLabel
    float top
    float bottom
    bool isBullish
    int startTime
    bool mitigated
    int mitigationTime

type cisd_Setup
    line cisdLine
    label baseDot
    label levelLabel
    array<label> projection_labels
    float basePrice
    bool bullish

type cisd_kz
    string _title
    array<box> _box
    array<line> _hi_line
    array<line> _lo_line
    array<label> _hi_label
    array<label> _lo_label
    array<bool> _hi_valid
    array<bool> _lo_valid
    float prevHigh = na
    float prevLow = na
    bool prevHighActive = false
    bool prevLowActive = false

type cisd_kz_helper
    cisd_kz _kz
    string session
    string tz
    color c
    string hi_txt
    string lo_txt

// ---- ifvg_* (source: IFVG Pro+ / "IFVG ") -----------------------------------
type ifvg_SwingFVG
    int    fvgBar1
    int    fvgBar3
    float  fvgTop
    float  fvgBottom
    int    swingBar
    float  swingPrice
    box    fvgBox
    bool   ifvgConfirmed = false
    bool   swept = false

type ifvg_Trade
    bool   bullish
    box    fvgBox
    line   entryLine
    label  entryLabel
    int    entryBar
    float  entryPrice
    line   slLine
    label  slLabel
    float  slPrice
    line   beLine
    label  beLabel
    float  bePrice
    array<line>  rrLines  = na
    array<label> rrLabels = na
    bool   resolved = false

type ifvg_SwingPoint
    float y
    int   t

type ifvg_SwingSet
    ifvg_SwingPoint[] points

// ---- uni_* (source: Unicorn Model pro) -------------------------------------
// MPL 2.0 — Copyright (c) 2026 fxraptor-alpha — attribution preserved per
// license and per spec §39.
type uni_HTFLevel
    string tfLabel
    string levelType
    bool isHigh
    float price
    int startBar
    bool isSwept
    int sweepBar
    string labelText

type uni_Setup
    string dir
    int sweepIndex
    float sweepExtreme
    float sweptLevel
    int sweptLevelStartBar
    int breakerStartIdx
    int breakerEndIdx
    float breakerTop
    float breakerBottom
    bool isConfirmed
    int confIndex
    float entryPrice
    float invalidationPrice
    bool isInvalidated
    bool isTargetHit
    line levelLine
    label levelLabel
    box breakerBox
    box fvgBox
    line[] targetLines
    label[] targetLabels
    label setupLabel

// ---- ts_* (source: ICT Turtle Soup Model) ----------------------------------
type ts_SwingPoint
    float price
    int   barIndex
    bool  taken = false

type ts_Model
    bool    isBull
    int     sweepBar
    float   sweepLevel
    float   sweepExtreme
    int     swingBar       = na
    int     mssBar         = na
    float   mssLevel       = na
    bool    mssConfirmed   = false
    bool    zoneConfluence = false
    string  zoneType       = ""
    float   zoneTop        = na
    float   zoneBot        = na
    int     zoneBar        = na
    bool    doublePurge    = false
    string  status         = "Formation"   // SOURCE DEFECT — see note below
    float   innerTarget     = na
    bool    innerSwept      = false
    int     innerSweepBar   = na
    line    innerLine       = na
    label   innerLabel      = na
    bool    entryConfirmed  = false
    int     entryBar        = na
    float   entryPrice      = na
    line    sweepLine      = na
    label   sweepLabel     = na
    line    mssLine        = na
    label   mssLabel       = na
    box     sArea          = na
    box     zoneBox        = na
    line    zoneCe         = na
    label   dpLabel        = na
    label   c1Label        = na
    line[]  sdLines
    label[] sdLabels
    // SOURCE DEFECT CORRECTED (Master Engine synthesis, documented per Locked
    // Decision #4 / Architecture Spec §C.5): the original ICT Turtle Soup
    // Model reuses the literal string "Formation" for BOTH the pre-sweep idle
    // state and the post-entry-confirmed state, colliding two semantically
    // distinct states under `m.status`. The underlying boolean flags used for
    // branching (entryConfirmed, mssConfirmed, isInvalidated, isTargetHit)
    // are UNCHANGED from source. A separate Master Engine-only enum field is
    // added below to resolve the collision WITHOUT touching the original
    // `status` field or any source-derived branching logic:
    string  me_correctedStatus = "FORMATION"
    // Valid values: "FORMATION" | "AWAITING_RETEST" | "ENTRY_CONFIRMED" |
    //               "RESOLVED_SUCCESS" | "INVALIDATED"
    // This field is set alongside (never instead of) the original `status`
    // field at each transition point when Milestone-ts logic is ported.

// =============================================================================
// PART 3 — NAMESPACED UTILITY-FUNCTION NAME MAP (reference only, this
// milestone does not yet port the function BODIES — see note below)
// =============================================================================
// The following collisions were identified across the five source files
// (Architecture Spec / Source Audit, Technical Risk #1-#2). This table fixes
// the FINAL name each function will carry once its body is ported in the
// milestone that owns its logic (per Implementation Order). No function
// bodies are ported in Milestone 1/2 — only types and the naming contract,
// so that later milestones have an unambiguous, pre-agreed target name and
// cannot introduce fresh collisions.
//
//   ORIGINAL NAME        SOURCE FILE(S)         NAMESPACED TARGET NAME(S)
//   -----------------    -----------------      ---------------------------------
//   f_lineStyle           CRT, Turtle Soup        crt_f_lineStyle / ts_f_lineStyle
//   f_labelSize           CRT, Turtle Soup        crt_f_labelSize / ts_f_labelSize
//   f_deleteModel         CRT, Turtle Soup        crt_f_deleteModel / ts_f_deleteModel
//   f_newModel            CRT, Turtle Soup        crt_f_newModel / ts_f_newModel
//   f_dashSize/f_dashPos  CRT                     crt_f_dashSize / crt_f_dashPos
//   f_tablePos            Turtle Soup             ts_f_tablePos
//   get_position/get_size CISD                    cisd_get_position / cisd_get_size
//   f_getTablePosition    Unicorn                 uni_f_getTablePosition
//   f_getLabelSize/       Unicorn                 uni_f_getLabelSize /
//     f_getLineStyle                               uni_f_getLineStyle
//   autoHTF               IFVG                    ifvg_autoHTF   (RETIRED —
//                                                   see Part 0 note; not ported,
//                                                   fixed hierarchy used instead)
//   getAutoHTFs           Unicorn                 uni_getAutoHTFs (RETIRED — same)
//   getHTFPeriod          CISD                    cisd_getHTFPeriod (RETIRED — same)
//   f_fractalTF           Turtle Soup             ts_f_fractalTF  (KEPT — Turtle
//                                                   Soup is an isolated alt-model
//                                                   per spec §21 and retains its
//                                                   own fractal TF selection
//                                                   internally; it is NOT part of
//                                                   the Master hierarchy, so its
//                                                   auto-TF system is source-
//                                                   faithful and unaffected by
//                                                   the Part-0 retirement above)
//   getSMTPair            CRT                     RETIRED — replaced by fixed
//                                                   me_SMT_PAIR (Part 0). Ticker-
//                                                   string-matching apparatus
//                                                   dropped as a documented
//                                                   Master Engine modification
//                                                   (Technical Risk #8).
//   getContractSize /     Unicorn                 RETIRED for this build —
//     calculatePositionSize /                      position-sizing is a Tier-3
//     formatPositionSize                            user-preference feature, out
//                                                   of scope for Core Engine
//                                                   Hardening milestones 1-13;
//                                                   may be reinstated namespaced
//                                                   (uni_getContractSize etc.) in
//                                                   a later phase without any
//                                                   architectural impact.
//
// All other function names in the five source files are already unique
// across the corpus and require no renaming; they will be ported with an
// explicit source-module prefix regardless (e.g. `f_findFVG` -> `ts_f_findFVG`)
// purely for consistency and traceability, per Architecture Spec §B.2 rule.
// =============================================================================

// =============================================================================
// PART 4 — GLOBAL STATE SCAFFOLD (declarations only; population begins in the
// milestone that owns each engine's logic)
// =============================================================================

// ---- Master Engine canonical state ----
var me_SetupGenealogy[] me_genealogyLog = array.new<me_SetupGenealogy>()
var string me_lastFinalState = "WAIT"

// ---- crt_* state (populated: Milestone 4) ----
var crt_Model crt_curModel  = crt_Model.new()
var crt_Model crt_prevModel = crt_Model.new()
var crt_Model[] crt_modelHistory = array.new<crt_Model>()
var crt_CandleSet crt_htf1 = crt_CandleSet.new(array.new<crt_Candle>(0), crt_CandleSettings.new(true, me_TF_4H, 4), na, array.new<line>(0))
var crt_SMT[] crt_smtArray = array.new<crt_SMT>()
var string crt_globalBias = "Neutral"

// ---- cisd_* state (populated: Milestone 5) — AUTHORITATIVE CISD ENGINE ----
var cisd_FVG[] cisd_activeFVGs = array.new<cisd_FVG>()
var cisd_Setup[] cisd_setups = array.new<cisd_Setup>()
var int cisd_market_bias = 0
var float cisd_level = na
var int cisd_start_bar = na
var float cisd_swing_pivot = na
var int cisd_swing_pivot_bar = na

// ---- ifvg_* state (populated: Milestone 8) ----
var ifvg_SwingFVG[] ifvg_validBullish = array.new<ifvg_SwingFVG>()
var ifvg_SwingFVG[] ifvg_validBearish = array.new<ifvg_SwingFVG>()
var ifvg_Trade[]    ifvg_activeTrades = array.new<ifvg_Trade>()
var ifvg_Trade[]    ifvg_setupRecords = array.new<ifvg_Trade>()

// ---- uni_* state (populated: Milestone 8) ----
var uni_HTFLevel[] uni_activeHTFLevels = array.new<uni_HTFLevel>()
var uni_Setup[] uni_activeSetups = array.new<uni_Setup>()

// ---- ts_* state (populated: Milestone 12, isolated alt-model, spec §21) ----
var ts_SwingPoint[] ts_bslArray = array.new<ts_SwingPoint>()
var ts_SwingPoint[] ts_sslArray = array.new<ts_SwingPoint>()
var ts_Model[] ts_models = array.new<ts_Model>()

// =============================================================================
// PART 5 — INPUT SCAFFOLD (namespaced groups; module-specific inputs are
// added by the milestone that implements that module's logic, to avoid an
// unreviewable wall of unused inputs at this stage)
// =============================================================================

grp_meCore = "Master Engine — Core"
me_i_debugMode = input.bool(true, "Debug Mode (spec §31)", group = grp_meCore,
     tooltip = "Compact diagnostic dump. Wired in Milestone 14.")
me_i_hideLosing = input.bool(false, "Hide Losing Setups", group = grp_meCore,
     tooltip = "LOCKED OFF per spec §17/§40.3 (anti-survivorship-bias rule). " +
     "This input exists for future display-only convenience but the research " +
     "/ genealogy / debug data layer will NEVER honor a 'true' value.")

grp_meContext = "Master Engine — 1W/1D Context (CONFIGURABLE RESEARCH MODULE)"
// Per approval Correction #3: this is an explicitly non-final, configurable
// research module, not a proven trading rule. Sensitivity inputs are added
// when Milestone 6 (1W/1D Context) is implemented.

// =============================================================================
// PART 5B — MILESTONE 3 INPUTS (Liquidity & Sweep adapter layer)
// =============================================================================

grp_crtLiq = "CRT — 4H Liquidity & Sweep (MASTER PRIMARY)"
// No additional inputs required here: the 4H timeframe is FIXED to me_TF_4H
// per the locked Master Engine hierarchy (Part 0). CRT's original tf_preset /
// "Auto" HTF-pairing input is retired for the primary path — this is the
// same class of retirement already applied to the other four sources' own
// auto-timeframe systems (Correction #2), now extended to CRT's own preset
// picker since the Master primary path has exactly one fixed timeframe.

grp_uniLiq = "Unicorn — Liquidity Sources (diagnostic, non-primary)"
// Unicorn's original "Automatic" htfMode (getAutoHTFs(), a generic
// chart-resolution-based tiering scheme unrelated to ICT session structure)
// is RETIRED per Correction #2 ("remove obsolete source auto-timeframe
// systems where superseded by the fixed Master Engine hierarchy"). "Manual"
// is now the only mode. This is a DOCUMENTED BEHAVIORAL CHANGE from source,
// not a silent one. Per-source enable/timeframe/type inputs and their
// DEFAULT VALUES are otherwise preserved verbatim from source.
uni_i_useA  = input.bool(true, "Source A", inline = "uniA", group = grp_uniLiq)
uni_i_tfA   = input.timeframe("15", "", inline = "uniA", group = grp_uniLiq)
uni_i_typeA = input.string("OHLC + Swing", "", options = ["OHLC", "Swing", "OHLC + Swing"], inline = "uniA", group = grp_uniLiq)
uni_i_useB  = input.bool(true, "Source B", inline = "uniB", group = grp_uniLiq)
uni_i_tfB   = input.timeframe("60", "", inline = "uniB", group = grp_uniLiq)
uni_i_typeB = input.string("OHLC + Swing", "", options = ["OHLC", "Swing", "OHLC + Swing"], inline = "uniB", group = grp_uniLiq)
uni_i_useC  = input.bool(true, "Source C", inline = "uniC", group = grp_uniLiq)
uni_i_tfC   = input.timeframe("240", "", inline = "uniC", group = grp_uniLiq)
uni_i_typeC = input.string("OHLC + Swing", "", options = ["OHLC", "Swing", "OHLC + Swing"], inline = "uniC", group = grp_uniLiq)
uni_i_useD  = input.bool(true, "Source D", inline = "uniD", group = grp_uniLiq)
uni_i_tfD   = input.timeframe("1440", "", inline = "uniD", group = grp_uniLiq)
uni_i_typeD = input.string("OHLC + Swing", "", options = ["OHLC", "Swing", "OHLC + Swing"], inline = "uniD", group = grp_uniLiq)

grp_ifvgLiq = "IFVG — HTF Liquidity (diagnostic, non-primary)"
// IFVG's original "Auto" htfMode (autoHTF()) is RETIRED for the identical
// reason given above. "Custom" is now the only mode. Default value (1D)
// unchanged from source.
ifvg_i_customHTF = input.timeframe("1D", "HTF", group = grp_ifvgLiq)

grp_tsLiq = "Turtle Soup — Pivot Liquidity (diagnostic, non-primary)"
// Default and bounds unchanged from source (i_swingLen, Context Swing Lookback).
ts_i_swingLen = input.int(15, "Context Swing Lookback", minval = 2, maxval = 50, group = grp_tsLiq)

// =============================================================================
// PART 6 — CANONICAL LOGS + ADAPTER HELPER FUNCTIONS (Master Engine synthesis)
// =============================================================================
// Every liquidity/sweep event recognized by any source engine below is
// appended to one of these two logs via the adapter helpers. Logs are
// capped (not truncated-and-forgotten — oldest entries are shifted out only
// to bound memory; nothing marked SWEPT/INVALIDATED is ever filtered out
// based on outcome, satisfying the "do not hide losing or invalidated
// events" requirement). The cap value mirrors the shared visual-object
// budget spirit (Architecture Spec §F.1) even though plain UDT arrays are
// not subject to Pine's line/box/label ceilings.

var me_LiquidityObject[] me_liquidityLog = array.new<me_LiquidityObject>()
var me_SweepEvent[]      me_sweepLog     = array.new<me_SweepEvent>()

me_pushLiquidity(me_LiquidityObject obj) =>
    me_liquidityLog.push(obj)
    if me_liquidityLog.size() > 500
        me_liquidityLog.shift()

me_pushSweep(me_SweepEvent ev) =>
    me_sweepLog.push(ev)
    if me_sweepLog.size() > 500
        me_sweepLog.shift()

// =============================================================================
// PART 7 — CRT: 4H LIQUIDITY + CONFIRMED SWEEP  (MASTER PRIMARY)
// =============================================================================
// Source: CRT Pro+ by Artas. Ported concept: the chart-native HTF-range
// accumulation and boundary-close sweep comparison used by CRT's own
// curModel/prevModel mechanism (the SAME technique CRT source uses for its
// candle panel and Model 1/2 — no request.security() call is needed for this
// because the script's own chart bars are already finer than or equal to
// the target 4H, so CRT accumulates HTF OHLC directly from chart-native
// high/low/close across `time(me_TF_4H)` boundaries — a genuinely
// non-repainting pattern already proven in source).
//
// SCOPE NOTE (Milestone 3 boundary): only the range (liquidity) and the
// CONFIRMED-on-close sweep comparison are ported here. CRT's Model 1 (Order
// Block) and Model 2 (manipOpen/reclaim) logic, its own real-time
// (`rtSweptHigh`/`rtSweptLow`) intrabar preview mechanism, and all box/line/
// label drawing are explicitly DEFERRED to Milestone 4 ("4H CRT primary
// engine") — porting them now would exceed this milestone's stated scope
// (Liquidity + Sweep adapters only) and would prematurely introduce visual
// elements ahead of the "no visual system yet" instruction.
//
// NON-REPAINT DESIGN DECISION (Locked Decision #2 / Correction §D): the
// Master PRIMARY sweep event is emitted ONLY from the confirmed-on-close
// comparison (curModel vs. the fully-closed prevModel) — never from CRT's
// intrabar realtime preview path. Because that realtime path is not ported
// in this milestone at all (see scope note above), there is currently no
// mechanism by which provisional/unconfirmed HTF data could reach
// me_sweepLog with isMasterPrimary=true. This satisfies §D directly.

var me_LiquidityObject crt_liqHigh = me_LiquidityObject.new(source = "CRT_HTF", liqType = "BSL", tf = me_TF_4H, price = na, createdBar = na, status = "CREATED", sweptBar = na, isMasterPrimary = true)
var me_LiquidityObject crt_liqLow  = me_LiquidityObject.new(source = "CRT_HTF", liqType = "SSL", tf = me_TF_4H, price = na, createdBar = na, status = "CREATED", sweptBar = na, isMasterPrimary = true)

bool crt_isNewHTF = ta.change(time(me_TF_4H)) != 0   // identical boundary idiom to CRT source

if crt_isNewHTF
    if not na(crt_curModel.o)
        crt_curModel.endBar := bar_index - 1

        if not na(crt_prevModel.o)
            // Confirmed sweep comparison — verbatim CRT source math, renamed only.
            crt_curModel.sweptHigh := crt_curModel.h > crt_prevModel.h and crt_curModel.c < crt_prevModel.h
            crt_curModel.sweptLow  := crt_curModel.l < crt_prevModel.l and crt_curModel.c > crt_prevModel.l
            crt_curModel.dpurge    := crt_curModel.sweptHigh and crt_curModel.sweptLow

            crt_curModel.bias := crt_curModel.dpurge ? (crt_curModel.c > crt_curModel.o ? "Bullish" : "Bearish") :
                 crt_curModel.sweptHigh ? "Bearish" :
                 crt_curModel.sweptLow  ? "Bullish" : "Neutral"
            crt_curModel.status := (crt_curModel.sweptHigh or crt_curModel.sweptLow) ? "Active" : "Formation"
            crt_globalBias := crt_curModel.bias

            // ---- Sweep adapter: emit Master-primary me_SweepEvent(s) ----
            if crt_curModel.sweptHigh
                crt_liqHigh.status   := "SWEPT"
                crt_liqHigh.sweptBar := crt_curModel.h_bar
                me_pushSweep(me_SweepEvent.new(source = "CRT", direction = "BEARISH_SWEEP", tf = me_TF_4H, barIndex = bar_index, sweepExtreme = crt_curModel.h, sweptLevel = crt_prevModel.h, isMasterPrimary = true))
            if crt_curModel.sweptLow
                crt_liqLow.status   := "SWEPT"
                crt_liqLow.sweptBar := crt_curModel.l_bar
                me_pushSweep(me_SweepEvent.new(source = "CRT", direction = "BULLISH_SWEEP", tf = me_TF_4H, barIndex = bar_index, sweepExtreme = crt_curModel.l, sweptLevel = crt_prevModel.l, isMasterPrimary = true))
            // NOTE: an explicit NO_SWEEP entry is intentionally NOT logged every
            // period — NO_SWEEP is the implicit default and logging it every 4H
            // close would flood me_sweepLog without adding information (spec §9:
            // "do not repeatedly signal the same [non-]event").

        crt_prevModel := crt_curModel

        // ---- Liquidity adapter: refresh canonical objects for the newly
        // confirmed 4H range (this becomes the ACTIVE liquidity going into the
        // next period) ----
        me_pushLiquidity(crt_liqHigh)   // log final state of the just-expired pair
        me_pushLiquidity(crt_liqLow)
        crt_liqHigh := me_LiquidityObject.new(source = "CRT_HTF", liqType = "BSL", tf = me_TF_4H, price = crt_prevModel.h, createdBar = crt_prevModel.h_bar, status = "ACTIVE", sweptBar = na, isMasterPrimary = true)
        crt_liqLow  := me_LiquidityObject.new(source = "CRT_HTF", liqType = "SSL", tf = me_TF_4H, price = crt_prevModel.l, createdBar = crt_prevModel.l_bar, status = "ACTIVE", sweptBar = na, isMasterPrimary = true)

    // Start accumulating the new (as-yet-unconfirmed) 4H model. Headless —
    // no box/line created at this milestone (see scope note above).
    crt_curModel := crt_Model.new(o = open, h = high, l = low, c = close, startBar = bar_index, endBar = bar_index, h_bar = bar_index, l_bar = bar_index, h_bar_open = open, l_bar_open = open)
else
    if high > crt_curModel.h
        crt_curModel.h          := high
        crt_curModel.h_bar      := bar_index
        crt_curModel.h_bar_open := open
    if low < crt_curModel.l
        crt_curModel.l          := low
        crt_curModel.l_bar      := bar_index
        crt_curModel.l_bar_open := open
    crt_curModel.c := close

// =============================================================================
// PART 8 — UNICORN: 4-SOURCE LIQUIDITY + NATIVE SWEEP  (diagnostic, non-primary)
// =============================================================================
// Source: Unicorn Model pro (MPL 2.0, (c) 2026 fxraptor-alpha). Ported
// unchanged: f_getHTFData (with non-repaint hardening, see note), f_registerLevel,
// f_findExtremeBar, and the native level-breach sweep-check loop.

// ---- ts note: NON-REPAINT HARDENING (Locked Decision #11 / Correction §D) ----
// Source Audit Repaint Risk #3 flagged this function's `isSwingHigh`/
// `isSwingLow` computation as HIGH severity: it evaluates on the CURRENT,
// potentially still-forming HTF bar inside request.security. This is a
// DOCUMENTED BEHAVIORAL MODIFICATION from source: the function now only
// returns non-na swing/pivot values when `barstate.isconfirmed` is true on
// the requested security context, mirroring the proven-safe pattern already
// used natively by CISD Pro+'s own `detectFVG()`. Unicorn's liquidity role is
// diagnostic-only (isMasterPrimary=false) so this hardening is not strictly
// required to satisfy §D's "no unconfirmed data may become a Master trigger"
// rule — it is applied anyway, in the spirit of "audit ALL repaint risk"
// (spec §34), so Debug/Genealogy output cannot show a diagnostic reading
// that would not actually have been visible in realtime.
uni_f_getHTFData() =>
    float hPrev = na
    float lPrev = na
    float latestSH = na
    float latestSL = na
    if barstate.isconfirmed
        hPrev := high[1]
        lPrev := low[1]
        bool isSwingHigh = high > high[1] and close < close[1]
        bool isSwingLow  = low < low[1] and close > close[1]
        latestSH := ta.valuewhen(isSwingHigh, high, 0)
        latestSL := ta.valuewhen(isSwingLow, low, 0)
    [hPrev, lPrev, latestSH, latestSL]

// f_findExtremeBar — unchanged from source (renamed only). Known heavy loop
// (Source Audit / Architecture Spec §F.2, up to 1000-bar scan) — preserved
// verbatim per "do not optimize by deleting required source logic."
uni_f_findExtremeBar(float priceVal, bool isHigh) =>
    int extBar = na
    if not na(priceVal)
        for i = 0 to 1000
            if i >= bar_index
                break
            float checkVal = isHigh ? high[i] : low[i]
            if math.abs(checkVal - priceVal) < (syminfo.mintick * 0.1)
                extBar := bar_index - i
                break
    extBar

// f_getTFLabel — unchanged from source (renamed only). Converts a timeframe
// string to a short display label (e.g. "60" -> "1H"). Used purely for
// uni_HTFLevel.labelText / uni_HTFLevel.tfLabel bookkeeping, not for
// canonical source tagging (see sourceTag parameter below).
uni_f_getTFLabel(string tf) =>
    seconds = timeframe.in_seconds(tf)
    res = ""
    if seconds < 60
        res := str.tostring(seconds) + "S"
    else if (seconds / 60) < 60
        res := str.tostring(math.round(seconds / 60)) + "m"
    else if (seconds / 3600) < 24
        res := str.tostring(math.round(seconds / 3600)) + "H"
    else if (seconds / 86400) < 7
        res := str.tostring(math.round(seconds / 86400)) + "D"
    else if (seconds / 86400) < 30
        res := str.tostring(math.round(seconds / 604800)) + "W"
    else
        res := str.tostring(math.round(seconds / 2592000)) + "M"
    res

// f_registerLevel — unchanged algorithm (renamed only), EXTENDED with:
//   (1) a `sourceTag` parameter ("A"/"B"/"C"/"D") identifying WHICH of the
//       four configured Unicorn sources triggered this registration, and
//   (2) a single adapter call (me_pushLiquidity) at the point a new level
//       is confirmed and pushed.
// Both are precisely the "translate source-native events into the
// canonical object" requirement (task §A) — the detection math itself
// (extreme-bar scan, already-breached check, existing-level merge) is
// byte-for-byte unchanged from source.
uni_f_registerLevel(string sourceTag, string tfLabel, string lvlType, bool isHigh, float priceVal) =>
    if not na(priceVal)
        int extBar = uni_f_findExtremeBar(priceVal, isHigh)
        int startB = na(extBar) ? bar_index : extBar

        int startSearch = math.max(startB + 1, bar_index - 999)
        bool alreadyBreached = false
        if not na(extBar) and startSearch <= bar_index - 1
            for i = startSearch to bar_index - 1
                float checkHigh = high[bar_index - i]
                float checkLow  = low[bar_index - i]
                if isHigh and checkHigh >= priceVal
                    alreadyBreached := true
                    break
                else if not isHigh and checkLow <= priceVal
                    alreadyBreached := true
                    break

        if not alreadyBreached
            bool exists = false
            if array.size(uni_activeHTFLevels) > 0
                for i = 0 to array.size(uni_activeHTFLevels) - 1
                    lvl = array.get(uni_activeHTFLevels, i)
                    if not lvl.isSwept and lvl.isHigh == isHigh and math.abs(lvl.price - priceVal) < (syminfo.mintick * 0.1)
                        string searchStr = tfLabel + " " + lvlType
                        if not str.contains(lvl.labelText, searchStr)
                            lvl.labelText := lvl.labelText + ", " + searchStr
                        exists := true
                        break

            if not exists
                string labelTxt = tfLabel + " " + lvlType
                uni_HTFLevel newLvl = uni_HTFLevel.new(tfLabel = tfLabel, levelType = lvlType, isHigh = isHigh, price = priceVal, startBar = startB, isSwept = false, sweepBar = na, labelText = labelTxt)
                array.push(uni_activeHTFLevels, newLvl)
                // ---- Liquidity adapter: canonical event, non-primary ----
                me_pushLiquidity(me_LiquidityObject.new(source = "UNICORN_" + sourceTag, liqType = isHigh ? "BSL" : "SSL", tf = tfLabel, price = priceVal, createdBar = startB, status = "ACTIVE", sweptBar = na, isMasterPrimary = false))

// ---- Per-source HTF fetches (4 independent request.security calls — see
// Milestone 3 request.security inventory in the accompanying review notes) ----
[uni_prevH_A, uni_prevL_A, uni_sh_A, uni_sl_A] = request.security(syminfo.tickerid, uni_i_tfA, uni_f_getHTFData(), barmerge.gaps_off, barmerge.lookahead_off)
[uni_prevH_B, uni_prevL_B, uni_sh_B, uni_sl_B] = request.security(syminfo.tickerid, uni_i_tfB, uni_f_getHTFData(), barmerge.gaps_off, barmerge.lookahead_off)
[uni_prevH_C, uni_prevL_C, uni_sh_C, uni_sl_C] = request.security(syminfo.tickerid, uni_i_tfC, uni_f_getHTFData(), barmerge.gaps_off, barmerge.lookahead_off)
[uni_prevH_D, uni_prevL_D, uni_sh_D, uni_sl_D] = request.security(syminfo.tickerid, uni_i_tfD, uni_f_getHTFData(), barmerge.gaps_off, barmerge.lookahead_off)

var float uni_lastPrevH_A = na
var float uni_lastSh_A = na
var float uni_lastPrevL_A = na
var float uni_lastSl_A = na
var float uni_lastPrevH_B = na
var float uni_lastSh_B = na
var float uni_lastPrevL_B = na
var float uni_lastSl_B = na
var float uni_lastPrevH_C = na
var float uni_lastSh_C = na
var float uni_lastPrevL_C = na
var float uni_lastSl_C = na
var float uni_lastPrevH_D = na
var float uni_lastSh_D = na
var float uni_lastPrevL_D = na
var float uni_lastSl_D = na

if uni_i_useA
    if uni_i_typeA == "OHLC" or uni_i_typeA == "OHLC + Swing"
        if uni_prevH_A != uni_lastPrevH_A or (na(uni_lastPrevH_A) and not na(uni_prevH_A))
            uni_lastPrevH_A := uni_prevH_A
            uni_f_registerLevel("A", uni_f_getTFLabel(uni_i_tfA), "OHLC", true, uni_prevH_A)
        if uni_prevL_A != uni_lastPrevL_A or (na(uni_lastPrevL_A) and not na(uni_prevL_A))
            uni_lastPrevL_A := uni_prevL_A
            uni_f_registerLevel("A", uni_f_getTFLabel(uni_i_tfA), "OHLC", false, uni_prevL_A)
    if uni_i_typeA == "Swing" or uni_i_typeA == "OHLC + Swing"
        if uni_sh_A != uni_lastSh_A or (na(uni_lastSh_A) and not na(uni_sh_A))
            uni_lastSh_A := uni_sh_A
            uni_f_registerLevel("A", uni_f_getTFLabel(uni_i_tfA), "Swing", true, uni_sh_A)
        if uni_sl_A != uni_lastSl_A or (na(uni_lastSl_A) and not na(uni_sl_A))
            uni_lastSl_A := uni_sl_A
            uni_f_registerLevel("A", uni_f_getTFLabel(uni_i_tfA), "Swing", false, uni_sl_A)

if uni_i_useB
    if uni_i_typeB == "OHLC" or uni_i_typeB == "OHLC + Swing"
        if uni_prevH_B != uni_lastPrevH_B or (na(uni_lastPrevH_B) and not na(uni_prevH_B))
            uni_lastPrevH_B := uni_prevH_B
            uni_f_registerLevel("B", uni_f_getTFLabel(uni_i_tfB), "OHLC", true, uni_prevH_B)
        if uni_prevL_B != uni_lastPrevL_B or (na(uni_lastPrevL_B) and not na(uni_prevL_B))
            uni_lastPrevL_B := uni_prevL_B
            uni_f_registerLevel("B", uni_f_getTFLabel(uni_i_tfB), "OHLC", false, uni_prevL_B)
    if uni_i_typeB == "Swing" or uni_i_typeB == "OHLC + Swing"
        if uni_sh_B != uni_lastSh_B or (na(uni_lastSh_B) and not na(uni_sh_B))
            uni_lastSh_B := uni_sh_B
            uni_f_registerLevel("B", uni_f_getTFLabel(uni_i_tfB), "Swing", true, uni_sh_B)
        if uni_sl_B != uni_lastSl_B or (na(uni_lastSl_B) and not na(uni_sl_B))
            uni_lastSl_B := uni_sl_B
            uni_f_registerLevel("B", uni_f_getTFLabel(uni_i_tfB), "Swing", false, uni_sl_B)

if uni_i_useC
    if uni_i_typeC == "OHLC" or uni_i_typeC == "OHLC + Swing"
        if uni_prevH_C != uni_lastPrevH_C or (na(uni_lastPrevH_C) and not na(uni_prevH_C))
            uni_lastPrevH_C := uni_prevH_C
            uni_f_registerLevel("C", uni_f_getTFLabel(uni_i_tfC), "OHLC", true, uni_prevH_C)
        if uni_prevL_C != uni_lastPrevL_C or (na(uni_lastPrevL_C) and not na(uni_prevL_C))
            uni_lastPrevL_C := uni_prevL_C
            uni_f_registerLevel("C", uni_f_getTFLabel(uni_i_tfC), "OHLC", false, uni_prevL_C)
    if uni_i_typeC == "Swing" or uni_i_typeC == "OHLC + Swing"
        if uni_sh_C != uni_lastSh_C or (na(uni_lastSh_C) and not na(uni_sh_C))
            uni_lastSh_C := uni_sh_C
            uni_f_registerLevel("C", uni_f_getTFLabel(uni_i_tfC), "Swing", true, uni_sh_C)
        if uni_sl_C != uni_lastSl_C or (na(uni_lastSl_C) and not na(uni_sl_C))
            uni_lastSl_C := uni_sl_C
            uni_f_registerLevel("C", uni_f_getTFLabel(uni_i_tfC), "Swing", false, uni_sl_C)

if uni_i_useD
    if uni_i_typeD == "OHLC" or uni_i_typeD == "OHLC + Swing"
        if uni_prevH_D != uni_lastPrevH_D or (na(uni_lastPrevH_D) and not na(uni_prevH_D))
            uni_lastPrevH_D := uni_prevH_D
            uni_f_registerLevel("D", uni_f_getTFLabel(uni_i_tfD), "OHLC", true, uni_prevH_D)
        if uni_prevL_D != uni_lastPrevL_D or (na(uni_lastPrevL_D) and not na(uni_prevL_D))
            uni_lastPrevL_D := uni_prevL_D
            uni_f_registerLevel("D", uni_f_getTFLabel(uni_i_tfD), "OHLC", false, uni_prevL_D)
    if uni_i_typeD == "Swing" or uni_i_typeD == "OHLC + Swing"
        if uni_sh_D != uni_lastSh_D or (na(uni_lastSh_D) and not na(uni_sh_D))
            uni_lastSh_D := uni_sh_D
            uni_f_registerLevel("D", uni_f_getTFLabel(uni_i_tfD), "Swing", true, uni_sh_D)
        if uni_sl_D != uni_lastSl_D or (na(uni_lastSl_D) and not na(uni_sl_D))
            uni_lastSl_D := uni_sl_D
            uni_f_registerLevel("D", uni_f_getTFLabel(uni_i_tfD), "Swing", false, uni_sl_D)

// ---- Unicorn native sweep-check loop (level breach) — unchanged from
// source, renamed only. Chart-native/intrabar touch-based, exactly as in
// source; diagnostic-only, isMasterPrimary=false throughout. ----
bool uni_sweptHighFlag = false   // source name "sweptBull": a HIGH/BSL level was touched
float uni_sweptHighPrice = na
bool uni_sweptLowFlag = false    // source name "sweptBear": a LOW/SSL level was touched
float uni_sweptLowPrice = na

if array.size(uni_activeHTFLevels) > 0
    for idx = array.size(uni_activeHTFLevels) - 1 to 0
        lvl = array.get(uni_activeHTFLevels, idx)
        bool swept = false
        if lvl.isHigh
            if high >= lvl.price
                swept := true
                uni_sweptHighFlag := true
                if na(uni_sweptHighPrice) or lvl.price > uni_sweptHighPrice
                    uni_sweptHighPrice := lvl.price
        else
            if low <= lvl.price
                swept := true
                uni_sweptLowFlag := true
                if na(uni_sweptLowPrice) or lvl.price < uni_sweptLowPrice
                    uni_sweptLowPrice := lvl.price
        if swept
            lvl.isSwept := true
            lvl.sweepBar := bar_index
            array.remove(uni_activeHTFLevels, idx)

while array.size(uni_activeHTFLevels) > 100
    array.shift(uni_activeHTFLevels)

// ---- Sweep adapter: canonical diagnostic events ----
// Direction mapping preserved from CRT's own bias convention (sweeping a
// HIGH/BSL level implies BEARISH follow-through; sweeping a LOW/SSL level
// implies BULLISH follow-through) for schema consistency across sources.
if uni_sweptHighFlag
    me_pushSweep(me_SweepEvent.new(source = "UNICORN", direction = "BEARISH_SWEEP", tf = "MULTI", barIndex = bar_index, sweepExtreme = high, sweptLevel = uni_sweptHighPrice, isMasterPrimary = false))
if uni_sweptLowFlag
    me_pushSweep(me_SweepEvent.new(source = "UNICORN", direction = "BULLISH_SWEEP", tf = "MULTI", barIndex = bar_index, sweepExtreme = low, sweptLevel = uni_sweptLowPrice, isMasterPrimary = false))

// =============================================================================
// PART 9 — IFVG: HTF-AGGREGATED SWING LIQUIDITY + NATIVE SWEEP (diagnostic)
// =============================================================================
// Source: IFVG Pro+ ("IFVG "). Ported unchanged: the chart-native HTF
// high/low aggregation across `time(htf)` boundaries and the SwingSet
// sweep-finder. This is IFVG's "Sweep Detector" region, a DIFFERENT code
// path from the pivot-origin IFVG-box detection flagged as Repaint Risk #4
// in the Source Audit (that region is POI logic, out of scope for
// Milestone 3 — it belongs to the POI layer, Milestone 8).
// No request.security() call is used here — matches source exactly (chart-
// native accumulation, same non-repainting boundary-trick class as CRT's).

method ifvg_addPoint(ifvg_SwingSet this, float y, int t) =>
    this.points.push(ifvg_SwingPoint.new(y, t))
    if this.points.size() > 50
        this.points.remove(0)

method ifvg_findSweep(ifvg_SwingSet this, float testPrice, bool isHigh) =>
    bool  found  = false
    float foundY = na
    int   foundT = na
    if this.points.size() > 0
        for i = this.points.size() - 1 to 0
            pt = this.points.get(i)
            bool isSwept = isHigh ? testPrice > pt.y : testPrice < pt.y
            if isSwept
                bool better = not found or (isHigh ? pt.y > foundY : pt.y < foundY)
                if better
                    foundY := pt.y
                    foundT := pt.t
                found := true
                this.points.remove(i)
    [found, foundY, foundT]

ifvg_htf = ifvg_i_customHTF   // "Auto" mode retired — see Part 5B note

var float ifvg_htfCurH     = high
var int   ifvg_htfCurHTime = time
var float ifvg_htfCurL     = low
var int   ifvg_htfCurLTime = time
var float[] ifvg_htfHighs    = array.new<float>()
var float[] ifvg_htfLows     = array.new<float>()
var int[]   ifvg_htfHighTime = array.new<int>()
var int[]   ifvg_htfLowTime  = array.new<int>()

ifvg_htfChanged = time(ifvg_htf) != time(ifvg_htf)[1]

if ifvg_htfChanged
    ifvg_htfHighs.push(ifvg_htfCurH)
    ifvg_htfLows.push(ifvg_htfCurL)
    ifvg_htfHighTime.push(ifvg_htfCurHTime)
    ifvg_htfLowTime.push(ifvg_htfCurLTime)
    if ifvg_htfHighs.size() > 55
        ifvg_htfHighs.shift()
        ifvg_htfLows.shift()
        ifvg_htfHighTime.shift()
        ifvg_htfLowTime.shift()
    ifvg_htfCurH     := high
    ifvg_htfCurHTime := time
    ifvg_htfCurL     := low
    ifvg_htfCurLTime := time
else
    if high > ifvg_htfCurH
        ifvg_htfCurH     := high
        ifvg_htfCurHTime := time
    if low < ifvg_htfCurL
        ifvg_htfCurL     := low
        ifvg_htfCurLTime := time

var ifvg_SwingSet ifvg_stHigh = ifvg_SwingSet.new(array.new<ifvg_SwingPoint>())
var ifvg_SwingSet ifvg_stLow  = ifvg_SwingSet.new(array.new<ifvg_SwingPoint>())

if ifvg_htfChanged and ifvg_htfHighs.size() >= 3
    ifvg_n = ifvg_htfHighs.size()
    ifvg_midHigh = ifvg_htfHighs.get(ifvg_n - 2)
    if ifvg_midHigh >= ifvg_htfHighs.get(ifvg_n - 3) and ifvg_midHigh >= ifvg_htfHighs.get(ifvg_n - 1)
        ifvg_stHigh.ifvg_addPoint(ifvg_midHigh, ifvg_htfHighTime.get(ifvg_n - 2))
        // ---- Liquidity adapter: canonical event, non-primary ----
        me_pushLiquidity(me_LiquidityObject.new(source = "IFVG_HTF", liqType = "BSL", tf = ifvg_htf, price = ifvg_midHigh, createdBar = bar_index, status = "ACTIVE", sweptBar = na, isMasterPrimary = false))

    ifvg_midLow = ifvg_htfLows.get(ifvg_n - 2)
    if ifvg_midLow <= ifvg_htfLows.get(ifvg_n - 3) and ifvg_midLow <= ifvg_htfLows.get(ifvg_n - 1)
        ifvg_stLow.ifvg_addPoint(ifvg_midLow, ifvg_htfLowTime.get(ifvg_n - 2))
        me_pushLiquidity(me_LiquidityObject.new(source = "IFVG_HTF", liqType = "SSL", tf = ifvg_htf, price = ifvg_midLow, createdBar = bar_index, status = "ACTIVE", sweptBar = na, isMasterPrimary = false))

[ifvg_sweepLowFound, ifvg_sweepLowPrice, ifvg_sweepLowTime]    = ifvg_stLow.ifvg_findSweep(low, false)
[ifvg_sweepHighFound, ifvg_sweepHighPrice, ifvg_sweepHighTime] = ifvg_stHigh.ifvg_findSweep(high, true)

// ---- Sweep adapter: canonical diagnostic events ----
if ifvg_sweepHighFound
    me_pushSweep(me_SweepEvent.new(source = "IFVG", direction = "BEARISH_SWEEP", tf = ifvg_htf, barIndex = bar_index, sweepExtreme = high, sweptLevel = ifvg_sweepHighPrice, isMasterPrimary = false))
if ifvg_sweepLowFound
    me_pushSweep(me_SweepEvent.new(source = "IFVG", direction = "BULLISH_SWEEP", tf = ifvg_htf, barIndex = bar_index, sweepExtreme = low, sweptLevel = ifvg_sweepLowPrice, isMasterPrimary = false))

// =============================================================================
// PART 10 — TURTLE SOUP: PIVOT LIQUIDITY + NATIVE SWEEP (diagnostic)
// =============================================================================
// Source: ICT Turtle Soup Model. Ported unchanged: ta.pivothigh/low-based
// swing detection (a genuinely confirmed pivot, i_swingLen bars on each
// side) and the native breach+close-back-confirmed sweep check. Chart-TF
// (30M), fully isolated per spec §21 — feeds diagnostic logs only.

ts_pivH = ta.pivothigh(high, ts_i_swingLen, ts_i_swingLen)
ts_pivL = ta.pivotlow(low,  ts_i_swingLen, ts_i_swingLen)

if not na(ts_pivH)
    int ts_actualBarH = bar_index - ts_i_swingLen
    ts_bslArray.push(ts_SwingPoint.new(ts_pivH, ts_actualBarH))
    while ts_bslArray.size() > 60
        ts_bslArray.shift()
    me_pushLiquidity(me_LiquidityObject.new(source = "TURTLESOUP_PIVOT", liqType = "BSL", tf = timeframe.period, price = ts_pivH, createdBar = ts_actualBarH, status = "ACTIVE", sweptBar = na, isMasterPrimary = false))

if not na(ts_pivL)
    int ts_actualBarL = bar_index - ts_i_swingLen
    ts_sslArray.push(ts_SwingPoint.new(ts_pivL, ts_actualBarL))
    while ts_sslArray.size() > 60
        ts_sslArray.shift()
    me_pushLiquidity(me_LiquidityObject.new(source = "TURTLESOUP_PIVOT", liqType = "SSL", tf = timeframe.period, price = ts_pivL, createdBar = ts_actualBarL, status = "ACTIVE", sweptBar = na, isMasterPrimary = false))

if ts_i_swingLen > 0 and array.size(ts_bslArray) > 0
    for i = array.size(ts_bslArray) - 1 to 0
        ts_sp = array.get(ts_bslArray, i)
        if not ts_sp.taken and high > ts_sp.price and bar_index > ts_sp.barIndex
            ts_sp.taken := true   // consumed regardless of outcome — verbatim source behavior
            if close < ts_sp.price
                me_pushSweep(me_SweepEvent.new(source = "TURTLESOUP", direction = "BEARISH_SWEEP", tf = timeframe.period, barIndex = bar_index, sweepExtreme = high, sweptLevel = ts_sp.price, isMasterPrimary = false))

if ts_i_swingLen > 0 and array.size(ts_sslArray) > 0
    for i = array.size(ts_sslArray) - 1 to 0
        ts_sp2 = array.get(ts_sslArray, i)
        if not ts_sp2.taken and low < ts_sp2.price and bar_index > ts_sp2.barIndex
            ts_sp2.taken := true
            if close > ts_sp2.price
                me_pushSweep(me_SweepEvent.new(source = "TURTLESOUP", direction = "BULLISH_SWEEP", tf = timeframe.period, barIndex = bar_index, sweepExtreme = low, sweptLevel = ts_sp2.price, isMasterPrimary = false))

